@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12

actor "User" as User
participant ":System\n(CineTrack)" as System
participant ":SharedPreferences" as Prefs

autonumber

== Scenario 1: Load User Preferences ==

User -> System : openPreferences()
activate System

System -> Prefs : getInt("cinema_radius_km", 10)\ngetString("default_region", "PT")
activate Prefs
Prefs --> System : currentPreferencesValues
deactivate Prefs

System -> System : instantiateUserPreferences()
System --> User : displayPreferencesForm(cinemaRadiusKm, defaultRegion)
deactivate System

== Scenario 2: Save Updated Preferences ==

User -> System : submitPreferences(cinemaRadiusKm, defaultRegion)
activate System

System -> System : validatePreferencesWithDomainModel()

alt [Invalid Values (radius < 1 or > 100, or empty region)]
    System --> User : showValidationError("Search radius must be between 1 and 100 km")
else [Valid Values]
    System -> Prefs : edit().putInt(...).putString(...).apply()
    activate Prefs
    Prefs --> System : savedAsynchronously
    deactivate Prefs
    
    System --> User : showSuccessToast("Preferences saved successfully")
end

deactivate System

@enduml
