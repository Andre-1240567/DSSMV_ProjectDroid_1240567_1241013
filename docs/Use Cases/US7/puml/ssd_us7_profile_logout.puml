@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12

actor "User" as User
participant ":System\n(CineTrack)" as System
participant ":Firebase Authentication" as Auth
participant ":Cloud Firestore" as Firestore

autonumber

== Scenario 1: Access and View Profile ==

User -> System : openProfile()
activate System

System -> System : startProfileActivity()
System -> Auth : getCurrentUser()
activate Auth
Auth --> System : firebaseUser(uid, email, displayName, metadata)
deactivate Auth

System -> Firestore : getUserMovieLists(userId)
activate Firestore
Firestore --> System : userMovieLists(listsCount)
deactivate Firestore

System -> System : populateProfileViews(email, creationDate, listsCount)
System --> User : displayProfileDetails()
deactivate System

== Scenario 2: Secure User Logout ==

User -> System : tapLogoutButton()
activate System

System --> User : showLogoutConfirmationDialog("Do you wish to log out?")

User -> System : confirmLogout()
System -> Auth : signOut()
activate Auth
Auth --> System : sessionTerminated()
deactivate Auth

System -> System : navigateToLogin(FLAG_ACTIVITY_NEW_TASK | FLAG_ACTIVITY_CLEAR_TASK)
System --> User : displayLoginScreen()

deactivate System

@enduml
