@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12

actor "User" as User
participant ":System\n(CineTrack)" as System
participant ":LocationManager\n(GPS Sensor)" as GPS
participant ":MapView\n(OSMDroid)" as MapView
participant ":FoursquareApiService\n(Retrofit)" as FsqApi
participant ":External Map App\n(Google Maps)" as MapApp

autonumber

== Scenario 1: Request Location & Render Interactive Map ==

User -> System : openNearbyCinemas()
activate System

System -> System : checkLocationPermission(ACCESS_FINE_LOCATION)

alt [Permission Not Granted]
    System --> User : requestPermissionDialog()
    User -> System : grantPermission()
end

System -> GPS : requestLocationUpdates() / getLastKnownLocation()
activate GPS
GPS --> System : currentLocation(latitude, longitude)
deactivate GPS

System -> System : readSearchRadiusFromPreferences()

System -> MapView : setCenter(currentLocation) & setZoom(dynamicZoom)
System -> MapView : drawRadiusCircumference(Polygon.pointsAsCircle, radiusMeters)
System -> MapView : addMarker(userLocationMarker)

System -> System : showLoadingIndicator(true)

System -> FsqApi : searchNearbyCinemas(latLng, query, categories, radiusMeters)
activate FsqApi
FsqApi -> FsqApi : GET places/search?ll=lat,lon&radius=...&sort=DISTANCE
FsqApi --> System : placesJsonPayload
deactivate FsqApi

System -> System : mapToCinemaEntities()
System -> System : showLoadingIndicator(false)

alt [No Cinemas Found in Radius]
    System --> User : showEmptyStateMessage("No cinemas found nearby")
else [Cinemas Found]
    System -> MapView : plotCinemaMarkers(cinemasList)
    System -> System : renderCinemasRecyclerView(cinemasList)
    System --> User : displayCinemasSplitView(map + list)
end

== Scenario 2: Synchronized Map Focus & Navigation ==

alt [User Taps Cinema in List]
    User -> System : tapCinemaCard(cinema)
    System -> MapView : animateTo(cinema.coordinates)
    System -> MapView : showInfoWindow(cinema.name, distance, address)
else [User Clicks Marker on Map]
    User -> MapView : clickMarker(cinema)
    MapView --> User : showPopupBubble(cinema.name, distance, address)
end

User -> System : requestDirections(cinema)
System -> MapApp : startActivity(ACTION_VIEW, "geo:lat,lng?q=CinemaName")
activate MapApp
MapApp --> User : showTurnByTurnNavigation()
deactivate MapApp

deactivate System
@enduml
