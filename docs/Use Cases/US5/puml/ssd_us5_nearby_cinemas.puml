@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12

actor "User" as User
participant ":System\n(CineTrack)" as System
participant ":LocationManager\n(GPS Sensor)" as GPS
participant ":FoursquareApiService\n(Retrofit)" as FsqApi
participant ":External Map App\n(Google Maps)" as MapApp

autonumber

== Scenario 1: Request Location & Search Nearby Cinemas ==

User -> System : openNearbyCinemas()
activate System

System -> System : checkLocationPermission(ACCESS_FINE_LOCATION)

alt [Permission Not Granted]
    System --> User : requestPermissionDialog()
    User -> System : grantPermission()
end

System -> GPS : requestLocationUpdates() / getLastKnownLocation()
activate GPS
GPS --> System : currentLocation(latitude, longitude)
deactivate GPS

System -> System : readSearchRadiusFromPreferences()
System -> System : showLoadingIndicator(true)

System -> FsqApi : searchNearbyCinemas(apiKey, latLng, radiusMeters)
activate FsqApi
FsqApi -> FsqApi : GET /v3/places/search?ll=lat,lon&radius=...&categories=10024
FsqApi --> System : placesJsonPayload
deactivate FsqApi

System -> System : mapToCinemaEntities()
System -> System : showLoadingIndicator(false)

alt [No Cinemas Found in Radius]
    System --> User : showEmptyStateMessage("No cinemas found nearby")
else [Cinemas Found]
    System -> System : renderCinemasRecyclerView(cinemasList)
    System --> User : displayNearbyCinemas(name, address, distanceMeters)
end

deactivate System

== Scenario 2: Open Cinema in External Maps (Directions) ==

User -> System : tapCinemaDirections(cinema)
activate System

System -> System : buildGeoIntent("geo:latitude,longitude?q=CinemaName")
System -> MapApp : startActivity(Intent.ACTION_VIEW, geoUri)
activate MapApp
MapApp --> User : openDirectionsInMapsApp()
deactivate MapApp

deactivate System

@enduml
