@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12

actor "Utilizador" as User
participant ":Sistema\n(CineTrack)" as System
participant ":Firebase Auth" as FirebaseAuth

autonumber

== Cenário: Autenticação de Utilizador (Login) ==

User -> System : introduzCredenciais(email, password)
activate System

System -> System : validaFormatoLocal(email, password)

alt [Credenciais com formato inválido]
    System --> User : apresentaErroValidacao("Email ou password inválidos")
else [Credenciais sintaticamente válidas]
    System -> FirebaseAuth : signInWithEmailAndPassword(email, password)
    activate FirebaseAuth
    
    alt [Sucesso na Autenticação]
        FirebaseAuth --> System : authResult(uid, email)
        System -> System : inicializaSessao(uid)
        System --> User : navegaParaMainActivity()
    else [Falha: Utilizador não encontrado ou password incorreta]
        FirebaseAuth --> System : authError(exception)
        System --> User : apresentaMensagemErro("Falha no login: credenciais incorretas")
    end
    deactivate FirebaseAuth
end

deactivate System

@enduml
