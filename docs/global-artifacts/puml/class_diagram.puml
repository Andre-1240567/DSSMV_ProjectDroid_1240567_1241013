@startuml
set namespaceSeparator none
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam classFontSize 13
skinparam classStereotypeFontSize 10
skinparam packageFontSize 13
skinparam classAttributeIconSize 0

skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #1A237E
    BorderColor #1A237E
    BorderThickness 1.3
    HeaderBackgroundColor #E8EAF6
}

skinparam enum {
    BackgroundColor #FFFFFF
    BorderColor #1A237E
    BorderThickness 1.3
    HeaderBackgroundColor #E8EAF6
}

skinparam package {
    BackgroundColor #FAFAFC
    BorderColor #283593
    BorderThickness 1.5
    FontColor #1A237E
    FontStyle bold
}

package "pt.isep.dssmv.projectdroid.model" {

    class User {
        - userId : String
        - name : String
        - email : String
        - registrationDate : Date
        --
        + User(userId : String, name : String, email : String)
        + getUserId() : String
        + getName() : String
        + setName(name : String) : void
        + getEmail() : String
        + setEmail(email : String) : void
        + getRegistrationDate() : Date
    }

    class MovieList {
        - listId : String
        - name : String
        - createdAt : Date
        --
        + MovieList(listId : String, name : String)
        + getListId() : String
        + getName() : String
        + setName(name : String) : void
        + getCreatedAt() : Date
    }

    class SavedMovie {
        - internalId : String
        - tmdbId : int
        - title : String
        - posterPath : String
        - releaseYear : int
        - overview : String
        - status : WatchStatus
        - rating : Rating
        --
        + SavedMovie(internalId : String, tmdbId : int, title : String)
        + getInternalId() : String
        + getTmdbId() : int
        + getTitle() : String
        + getStatus() : WatchStatus
        + setStatus(status : WatchStatus) : void
        + getRating() : Rating
        + setRating(rating : Rating) : void
    }

    enum WatchStatus {
        PLAN_TO_WATCH
        WATCHING
        WATCHED
        FAVORITE
    }

    class Rating {
        - ratingId : String
        - score : float
        - comment : String
        - createdAt : Date
        --
        + Rating(ratingId : String, score : float, comment : String)
        + getRatingId() : String
        + getScore() : float
        + setScore(score : float) : void
        + getComment() : String
    }

    class Cinema {
        - fsqId : String
        - name : String
        - latitude : double
        - longitude : double
        - address : String
        - distanceMeters : int
        --
        + Cinema(fsqId : String, name : String, lat : double, lon : double)
        + getFsqId() : String
        + getName() : String
        + getLatitude() : double
        + getLongitude() : double
        + getAddress() : String
        + getDistanceMeters() : int
    }

    class WatchProvider {
        - providerId : int
        - name : String
        - logoPath : String
        - accessType : String
        --
        + WatchProvider(id : int, name : String, logo : String, type : String)
        + getProviderId() : int
        + getName() : String
        + getLogoPath() : String
        + getAccessType() : String
    }

    class UserPreferences {
        - cinemaRadiusKm : int
        - defaultRegion : String
        - minRating : float
        - minReleaseYear : int
        - streamingProviders : Set<String>
        - shakeThreshold : float
        --
        + UserPreferences()
        + UserPreferences(radiusKm : int, region : String)
        + getCinemaRadiusKm() : int
        + getDefaultRegion() : String
        + getMinRating() : float
        + getShakeThreshold() : float
    }
}

package "pt.isep.dssmv.projectdroid.exceptions" {
    class InvalidDataException <<checked>> {
        + InvalidDataException(message : String)
    }

    class InvalidRatingException <<checked>> {
        + InvalidRatingException(message : String)
    }

    Exception <|-- InvalidDataException
    Exception <|-- InvalidRatingException
}

' Domain Associations
User "1" *-- "0..*" MovieList : owns >
User "1" *-- "1" UserPreferences : configures >
User ..> Cinema : queries >

MovieList "1" o-- "0..*" SavedMovie : contains >

SavedMovie "1" *-- "0..1" Rating : rated by >
SavedMovie --> "1" WatchStatus : status >
SavedMovie "0..*" ..> "0..*" WatchProvider : references >

WatchProvider ..> InvalidDataException : <<throws>>
Rating ..> InvalidRatingException : <<throws>>

@enduml
