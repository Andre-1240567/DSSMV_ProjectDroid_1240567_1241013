@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

package "pt.isep.dssmv.projectdroid.exceptions" {
    class InvalidDataException <<checked exception>> {
        + InvalidDataException(message : String)
    }

    class InvalidRatingException <<checked exception>> {
        + InvalidRatingException(message : String)
    }

    Exception <|-- InvalidDataException
    Exception <|-- InvalidRatingException
}

package "pt.isep.dssmv.projectdroid.model" {

    enum WatchStatus {
        PLAN_TO_WATCH
        WATCHING
        WATCHED
        FAVORITE
    }

    enum SavedMovieSortOption {
        TITLE_ASC
        TITLE_DESC
        RATING_DESC
        RATING_ASC
        YEAR_DESC
        YEAR_ASC
    }

    class User {
        - userId : String
        - name : String
        - email : String
        - registrationDate : Date
        + User(userId : String, name : String, email : String)
        + User(userId : String, name : String, email : String, registrationDate : Date)
        + getUserId() : String
        + getName() : String
        + setName(name : String) : void
        + getEmail() : String
        + setEmail(email : String) : void
        + getRegistrationDate() : Date
        + toString() : String
        + equals(o : Object) : boolean
        + hashCode() : int
    }

    class MovieList {
        - listId : String
        - name : String
        - createdAt : Date
        + MovieList(listId : String, name : String)
        + MovieList(listId : String, name : String, createdAt : Date)
        + getListId() : String
        + getName() : String
        + setName(name : String) : void
        + getCreatedAt() : Date
        + toString() : String
        + equals(o : Object) : boolean
        + hashCode() : int
    }

    class SavedMovie {
        - internalId : String
        - tmdbId : int
        - title : String
        - posterPath : String
        - releaseYear : int
        - overview : String
        - status : WatchStatus
        - rating : Rating
        + SavedMovie(internalId : String, tmdbId : int, title : String)
        + getInternalId() : String
        + getTmdbId() : int
        + getTitle() : String
        + getPosterPath() : String
        + setPosterPath(posterPath : String) : void
        + getReleaseYear() : int
        + setReleaseYear(releaseYear : int) : void
        + getOverview() : String
        + setOverview(overview : String) : void
        + getStatus() : WatchStatus
        + setStatus(status : WatchStatus) : void
        + getRating() : Rating
        + setRating(rating : Rating) : void
        + toString() : String
        + equals(o : Object) : boolean
        + hashCode() : int
    }

    class Rating {
        - ratingId : String
        - score : float
        - comment : String
        - createdAt : Date
        + Rating(ratingId : String, score : float, comment : String)
        + Rating(ratingId : String, score : float, comment : String, createdAt : Date)
        + getRatingId() : String
        + getScore() : float
        + setScore(score : float) : void
        + getComment() : String
        + setComment(comment : String) : void
        + getCreatedAt() : Date
        + toString() : String
        + equals(o : Object) : boolean
        + hashCode() : int
    }

    class Cinema {
        - fsqId : String
        - name : String
        - latitude : double
        - longitude : double
        - address : String
        - distanceMeters : int
        + Cinema(fsqId : String, name : String, latitude : double, longitude : double)
        + getFsqId() : String
        + getName() : String
        + getLatitude() : double
        + getLongitude() : double
        + getAddress() : String
        + setAddress(address : String) : void
        + getDistanceMeters() : int
        + setDistanceMeters(distanceMeters : int) : void
        + toString() : String
    }

    class WatchProvider {
        - providerId : int
        - name : String
        - logoPath : String
        - accessType : String
        + WatchProvider(providerId : int, name : String, logoPath : String, accessType : String)
        + getProviderId() : int
        + getName() : String
        + getLogoPath() : String
        + getAccessType() : String
        + toString() : String
    }

    class UserPreferences {
        - cinemaRadiusKm : int
        - defaultRegion : String
        - minRating : float
        - minReleaseYear : int
        - streamingProviders : Set<String>
        - shakeThreshold : float
        + UserPreferences()
        + UserPreferences(cinemaRadiusKm : int, defaultRegion : String)
        + UserPreferences(cinemaRadiusKm : int, defaultRegion : String, minRating : float, minYear : int, providers : Set<String>, threshold : float)
        + getCinemaRadiusKm() : int
        + setCinemaRadiusKm(cinemaRadiusKm : int) : void
        + getDefaultRegion() : String
        + setDefaultRegion(defaultRegion : String) : void
        + getMinRating() : float
        + setMinRating(minRating : float) : void
        + getMinReleaseYear() : int
        + setMinReleaseYear(minReleaseYear : int) : void
        + getStreamingProviders() : Set<String>
        + setStreamingProviders(streamingProviders : Set<String>) : void
        + getShakeThreshold() : float
        + setShakeThreshold(shakeThreshold : float) : void
        + getFormattedWatchProviders() : String
        + toString() : String
    }

    class SavedMovieFilterSorter <<utility>> {
        + {static} COMPARATOR_TITLE_ASC : Comparator<SavedMovie>
        + {static} COMPARATOR_TITLE_DESC : Comparator<SavedMovie>
        + {static} COMPARATOR_RATING_DESC : Comparator<SavedMovie>
        + {static} COMPARATOR_RATING_ASC : Comparator<SavedMovie>
        + {static} COMPARATOR_YEAR_DESC : Comparator<SavedMovie>
        + {static} COMPARATOR_YEAR_ASC : Comparator<SavedMovie>
        + {static} getComparator(option : SavedMovieSortOption) : Comparator<SavedMovie>
        + {static} filter(movies : List<SavedMovie>, status : WatchStatus, query : String) : List<SavedMovie>
        + {static} sort(movies : List<SavedMovie>, option : SavedMovieSortOption) : List<SavedMovie>
        + {static} filterAndSort(movies : List<SavedMovie>, status : WatchStatus, query : String, option : SavedMovieSortOption) : List<SavedMovie>
    }

    class MovieShareFormatter <<utility>> {
        + {static} format(movie : SavedMovie) : String
        + {static} format(title : String, releaseYear : int, overview : String, tmdbId : int) : String
        + {static} formatDetails(title : String, releaseYear : int, overview : String, tmdbId : int, score : Float, comment : String, status : WatchStatus) : String
    }
}

User ..> InvalidDataException : throws
MovieList ..> InvalidDataException : throws
SavedMovie ..> InvalidDataException : throws
Rating ..> InvalidRatingException : throws
UserPreferences ..> InvalidDataException : throws

SavedMovie --> WatchStatus
SavedMovie "1" o-- "0..1" Rating : rating
SavedMovieFilterSorter ..> SavedMovie : sorts & filters
SavedMovieFilterSorter ..> SavedMovieSortOption : uses
MovieShareFormatter ..> SavedMovie : formats

@enduml
