@startuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12

skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    BorderThickness 1.5
    ArrowColor #2C3E50
    HeaderBackgroundColor #ECEFF1
}

[*] --> AppLaunch

state AppLaunch <<choice>>
note right of AppLaunch: Check FirebaseAuth.getInstance().getCurrentUser()

AppLaunch --> LoginActivity : [No active session]
AppLaunch --> MainActivity : [Session exists]

state LoginActivity {
    [*] --> DisplayLoginForm
    DisplayLoginForm --> Authenticate : Submit credentials
    Authenticate --> DisplayLoginForm : [Error: Invalid email/password]
}

LoginActivity --> RegisterActivity : "Create Account" (Explicit Intent)
LoginActivity --> MainActivity : [Auth Success] (Clear Task Stack)

state RegisterActivity {
    [*] --> DisplayRegisterForm
    DisplayRegisterForm --> CreateAccount : Submit registration
    CreateAccount --> DisplayRegisterForm : [Error: Email in use / Weak password]
}

RegisterActivity --> LoginActivity : "Back to Login"
RegisterActivity --> MainActivity : [Registration Success] (Clear Task Stack)

state MainActivity {
    [*] --> ViewDashboard
    ViewDashboard --> CreateList : Tap FAB "Create List"
    ViewDashboard --> ShakeSuggestion : Physical shake (Accelerometer)
}

MainActivity --> MovieSearchActivity : Tap Search (Explicit Intent)
MainActivity --> ListDetailsActivity : Select custom list (Explicit Intent)
MainActivity --> CinemasActivity : Click "Nearby Cinemas" (Explicit Intent)
MainActivity --> ProfileActivity : Click "Profile" icon (Explicit Intent)

state MovieSearchActivity {
    [*] --> DisplaySearchBar
    DisplaySearchBar --> QueryTmdb : Enter query (Debounce 400ms)
    QueryTmdb --> DisplaySearchResults : Results loaded
}

MovieSearchActivity --> MovieDetailActivity : Select movie (Explicit Intent)

state ListDetailsActivity {
    [*] --> LoadSavedMovies
    LoadSavedMovies --> DisplaySavedMovies : Firestore loaded
    DisplaySavedMovies --> FilterAndSort : Apply WatchStatus / Sort
    DisplaySavedMovies --> QuickRateMovie : Submit Rating (1.0 - 5.0)
    DisplaySavedMovies --> DeleteMovie : Remove from list
}

ListDetailsActivity --> MovieSearchActivity : Tap "Add Movie" (Explicit Intent)
ListDetailsActivity --> MovieDetailActivity : Tap movie item (Explicit Intent)

state MovieDetailActivity {
    [*] --> DisplayDetails
    DisplayDetails --> AddToList : "Add to List" (Firestore)
    DisplayDetails --> SubmitRating : "Rate Movie" (Firestore & TMDB REST)
}

state CinemasActivity {
    [*] --> CheckLocationPermission
    CheckLocationPermission --> RequestGPS : Permission granted
    RequestGPS --> FetchFoursquareCinemas : Coords acquired
    FetchFoursquareCinemas --> DisplayCinemaList : Display RecyclerView / Open Map
}

state ProfileActivity {
    [*] --> DisplayProfile
    DisplayProfile --> SavePreferences : Update preferences (SharedPreferences .apply())
}

ProfileActivity --> LoginActivity : "Logout" (FirebaseAuth.signOut(), Clear Task Stack)

' External Interactions via Implicit Intents
state "External Apps (Implicit Intents)" as ExternalApps {
    state YouTubeApp : ACTION_VIEW ("vnd.youtube:...")
    state GoogleMaps : ACTION_VIEW ("geo:lat,lng?q=Cinema")
    state SocialShare : ACTION_SEND (Intent.createChooser)
}

MovieDetailActivity --> YouTubeApp : "Watch Trailer"
MovieDetailActivity --> SocialShare : "Share Movie"
CinemasActivity --> GoogleMaps : Click cinema "Open Map / Directions"

@enduml
