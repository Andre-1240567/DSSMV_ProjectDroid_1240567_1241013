@startuml
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #1A237E
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #1A237E
    ArrowColor #283593
}

left to right direction

actor "User" as User
actor "GPS / Location Provider\n(LocationManager)" as GPS <<Hardware>>
actor "Foursquare Places API" as FSQ <<REST API>>
actor "Google Maps / Waze" as ExtMaps <<Navigation App>>

rectangle "Geolocation, Cinemas and Mapping Subsystem" {
    usecase "UC05: Locate Nearby Cinemas" as UC05
    usecase "UC05.1: Check Runtime Permission\n(ACCESS_FINE_LOCATION)" as UC05_1
    usecase "UC05.2: Obtain Native GPS Coordinates" as UC05_2
    usecase "UC05.3: Query Cinema POIs (Cat. 10024)" as UC05_3
    
    usecase "UC05.4: Display Interactive Map (OSMDroid)" as UC05_4
    usecase "UC05.5: Render Translucent Radius Circle" as UC05_5
    usecase "UC05.6: Display Clickable Markers with Popups" as UC05_6
    usecase "UC05.7: Toggle Layout (Both / Map / List)" as UC05_7
    
    usecase "UC05.8: Launch Navigation Route (geo: Intent)" as UC05_8
    usecase "UC08: Configure Radius and Local Preferences" as UC08
}

' User Interactions
User --> UC05
User --> UC05_7
User --> UC05_8
User --> UC08

' Inclusion and Extension Relationships
UC05 ..> UC05_1 : <<include>>
UC05 ..> UC05_2 : <<include>>
UC05 ..> UC05_3 : <<include>>
UC05 <.. UC05_4 : <<include>>

UC05_4 ..> UC05_5 : <<include>>
UC05_4 ..> UC05_6 : <<include>>

UC05 <.. UC05_7 : <<extend>>
UC05 <.. UC05_8 : <<extend>>
UC08 ..> UC05 : <<influences radius>>

' External Integrations
UC05_1 ..> GPS : ActivityCompat.requestPermissions()
UC05_2 ..> GPS : getLastKnownLocation()
UC05_3 ..> FSQ : GET /places/search (Bearer Token)
UC05_8 ..> ExtMaps : startActivity(ACTION_VIEW, "geo:lat,lng")

@enduml
