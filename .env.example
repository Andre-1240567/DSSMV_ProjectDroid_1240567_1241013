# CineTrack Environment Variables
# Copy this file to .env and insert your real API keys.
# DO NOT commit .env to version control!

# The Movie Database (TMDB) API Key (Used in US4, US10)
TMDB_API_KEY=your_tmdb_api_key_here

# Foursquare Places API Key (Used in US5)
FOURSQUARE_API_KEY=your_foursquare_api_key_here
