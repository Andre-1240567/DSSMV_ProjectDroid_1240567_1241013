<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_title_preferences"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- SECTION 1: General Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_general_prefs"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCinemaRadius"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:helperText="@string/helper_cinema_radius"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCinemaRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_cinema_radius"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="number"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutDefaultRegion"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:helperText="@string/helper_default_region"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDefaultRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_default_region"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textCapCharacters"
                android:maxLength="5"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Theme Mode Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_theme_mode"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerThemeMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/badge_background"
            android:backgroundTint="@color/badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="16dp" />

        <!-- SECTION 2: Shake Recommendation Filters -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_shake_prefs"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutMinRating"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:helperText="@string/helper_min_rating"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextMinRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_min_rating"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="numberDecimal"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutMinYear"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:helperText="@string/helper_min_year"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextMinYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_min_year"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Streaming Subscriptions Checkboxes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_streaming_services"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/checkboxNetflix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_netflix"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkboxHboMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_hbo"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkboxDisneyPlus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_disney"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkboxPrimeVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_prime"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkboxAppleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_apple"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Shake Sensitivity Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_shake_sensitivity"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerShakeSensitivity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
